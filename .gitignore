# Large retained benchmark output is kept on the worker volume.
/benchmarks/iterations/**/site-comparison-buckets/
/benchmarks/iterations/**/*.sites.csv
/benchmarks/classic/iterations/**/stdout

# Annotated full-report dumps remain local and on retained EC2 volumes.
/benchmarks/iterations/**/output.jsonl

/dist/

# Full summary outputs are retained locally; metadata and timings are versioned.
/benchmarks/summary/iterations/**/stdout.jsonl

# Retain ddG raw outputs locally; publish iteration metadata, ledgers and hashes.
/benchmarks/ddg/iterations/**/*.stdout
/benchmarks/ddg/iterations/**/report.jsonl
